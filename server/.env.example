# Server
PORT=3000
NODE_ENV=development

# CORS: comma-separated list of allowed origins, or "*" for any
CORS_ORIGIN=*

# ElevenLabs
# Get a key at https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Default voice id used when client doesn't specify one.
# If you have an authorized Lester Levenson voice clone, put its voice_id here.
# Otherwise use a warm-sounding ElevenLabs preset voice id.
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Model: eleven_multilingual_v2 supports Chinese; eleven_turbo_v2_5 is faster.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Session
SESSION_TTL_MINUTES=60
