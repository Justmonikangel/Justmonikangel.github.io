PORT=8787
DATA_DIR=./data
SKILLS_DIR=./skills
RELAY_TOKEN=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

CLAUDE_MODEL=claude-opus-4-7
CLAUDE_THINKING_BUDGET=32000
CLAUDE_MAX_TOKENS=64000

GPT_MODEL=gpt-5
GPT_REASONING_EFFORT=high

COMPACTION_THRESHOLD_TOKENS=140000
COMPACTION_KEEP_RECENT_TURNS=8

# OmbreBrain mode switch:
# - leave everything blank to disable semantic recall
# - HTTP adapter: set OMBREBRAIN_MODE=http and OMBREBRAIN_URL
# - official OmbreBrain MCP: set OMBREBRAIN_MODE=mcp and then either
#   - remote streamable HTTP: OMBREBRAIN_MCP_TRANSPORT=streamable-http + OMBREBRAIN_MCP_URL=https://host/mcp
#   - local stdio: OMBREBRAIN_MCP_TRANSPORT=stdio + OMBREBRAIN_MCP_COMMAND=python + OMBREBRAIN_MCP_ARGS=["server.py"]
OMBREBRAIN_MODE=
OMBREBRAIN_URL=
OMBREBRAIN_API_KEY=
OMBREBRAIN_MCP_TRANSPORT=streamable-http
OMBREBRAIN_MCP_URL=
OMBREBRAIN_MCP_COMMAND=
OMBREBRAIN_MCP_ARGS=
OMBREBRAIN_MCP_ENV_JSON=
