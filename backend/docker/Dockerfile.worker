FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System packages: BLAST+, DIAMOND, HMMER, Foldseek, Prokka (apt where possible).
# Foldseek is fetched from upstream release tarball (no apt package).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ncbi-blast+ \
        diamond-aligner \
        hmmer \
        prokka \
        curl \
        ca-certificates \
        wget \
        libpq-dev \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Foldseek static binary
RUN mkdir -p /opt && \
    wget -qO- https://mmseqs.com/foldseek/foldseek-linux-avx2.tar.gz \
        | tar -xz -C /opt && \
    ln -s /opt/foldseek/bin/foldseek /usr/local/bin/foldseek

COPY pyproject.toml ./
RUN pip install --upgrade pip && pip install ".[ml]"

COPY . .

# Celery worker entrypoint
CMD ["celery", "-A", "app.workers.celery_app:celery_app", "worker", "--loglevel=INFO", "--concurrency=2"]
