# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_DSN=postgresql+psycopg://bact:bact@postgres:5432/bact

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Storage ---
DATA_DIR=/data
FASTA_DIR=/data/fasta
STRUCT_DIR=/data/structures
INDEX_DIR=/data/indexes
BLOB_DIR=/data/blob

# --- Tool binaries (must be on PATH inside worker image) ---
BLAST_BIN=blastp
DIAMOND_BIN=diamond
FOLDSEEK_BIN=foldseek
HMMER_BIN=hmmscan
PFAM_HMM=/data/pfam/Pfam-A.hmm
RAST_BIN=rast2-submit-genome
PROKKA_BIN=prokka

# --- ERAST-style embedding pipeline ---
ESM_MODEL=facebook/esm2_t33_650M_UR50D
ESM_DEVICE=cpu
ESM_BATCH=8
FAISS_INDEX_PATH=/data/indexes/faiss/proteins.index
FAISS_NLIST=4096
FAISS_NPROBE=32
RERANKER_CKPT=
EMBED_DIM=1280

# --- External APIs ---
UNIPROT_BASE=https://rest.uniprot.org
ALPHAFOLD_BASE=https://alphafold.ebi.ac.uk/files
ALPHAFOLD_CONCURRENCY=5
